@{
    ViewData["Title"] = "تسجيل دخول الإدارة - البيت السعودي";
    Layout = "_Layout";
}

<div class="container py-5 my-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="size-guide-card text-center p-4 p-md-5">
                <img src="~/images/logo.png" alt="البيت السعودي" style="max-height: 60px; width: auto; object-fit: contain; margin-bottom: 15px; filter: drop-shadow(0 0 15px rgba(212, 175, 55, 0.6));" />
                <h3 class="font-amiri text-gold mb-1">لوحة إدارة البيت السعودي</h3>
                <p class="text-champagne-muted fs-sm mb-4">
                    مخصصة فقط لإدارة وإضافة وحذف عبايات المعرض
                </p>

                @if (ViewBag.ErrorMessage != null)
                {
                    <div class="alert alert-danger mb-3" style="background: rgba(220, 53, 69, 0.2); border: 1px solid #dc3545; color: #ffb8b8;">
                        <i class="fa-solid fa-triangle-exclamation me-2"></i> @ViewBag.ErrorMessage
                    </div>
                }

                <form asp-action="Login" method="post" class="text-start">
                    @Html.AntiForgeryToken()
                    <div class="mb-4">
                        <label class="form-label text-gold fs-sm">كلمة مرور الإدارة</label>
                        <div class="input-group">
                            <span class="input-group-text bg-dark border-gold text-gold" style="border-color: var(--gold-border);">
                                <i class="fa-solid fa-lock"></i>
                            </span>
                            <input type="password" name="password" class="size-calc-input text-start" placeholder="أدخل كلمة المرور..." required autofocus />
                        </div>
                        <small class="text-muted fs-sm mt-1 d-block">كلمة المرور الافتراضية: <strong class="text-gold">saudi</strong> (يمكنك تغييرها في أي وقت)</small>
                    </div>

                    <button type="submit" class="btn btn-gold w-100 py-2 fs-5">
                        <i class="fa-solid fa-arrow-right-to-bracket me-2"></i> تسجيل الدخول
                    </button>
                </form>

                <div class="mt-4 pt-3 border-top border-gold-subtle">
                    <a href="/" class="text-champagne-muted text-decoration-none fs-sm">
                        <i class="fa-solid fa-arrow-right me-1"></i> العودة للمتجر الرئيسي
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
